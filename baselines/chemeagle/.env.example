# ChemEagle (upstream baseline) — environment template.
# Copy to .env and fill in. The pipeline reads these via os.getenv at
# import time (see main.py:25–29).
#
# NOTE: ChemEagle uses non-standard env names. If your Azure keys are
# stored under the more common AZURE_OPENAI_* names (as in this repo's
# collective_autogen/.env), either rename them as below, or export them
# in your shell before running:
#
#   export API_KEY="$AZURE_OPENAI_API_KEY"
#   export AZURE_ENDPOINT="$AZURE_OPENAI_ENDPOINT"
#   export API_VERSION="$AZURE_OPENAI_API_VERSION"

# ─── Required ──────────────────────────────────────────────────────────
API_KEY=
AZURE_ENDPOINT=
API_VERSION=2024-12-01-preview

# ─── How to change the model ───────────────────────────────────────────
# The model name is HARDCODED inside the source (look for `model='gpt-5-mini'`
# in main.py and get_*_agent.py). To swap to a different Azure deployment,
# edit those literals or expose a small wrapper. There is no CLI flag.
#
# Quick one-shot from the shell (uses sed, edit at your own risk):
#   grep -rln "model='gpt-5-mini'" .
