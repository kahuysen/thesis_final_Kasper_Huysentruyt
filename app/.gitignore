# ── Local config & secrets ────────────────────────────────────────────
.env

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv
.venv-*

# ── Per-run generated data (large, machine-specific) ─────────────────
runs/
pdf_jobs/

# ── Frontend ──────────────────────────────────────────────────────────
web/node_modules/
web/dist/
web/.vite/
# Vite source maps in the production bundle — keep the JS/PNG but skip maps.
app/static/assets/*.map

# ── Editor / OS / agent caches ────────────────────────────────────────
.DS_Store
.claude/
.vscode/
.idea/
*.log
