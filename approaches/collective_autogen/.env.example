# Multi-agent (AutoGen) pipeline — environment template.
# Copy to .env and fill in real values for the backend you want to use.

# ─── Default provider ────────────────────────────────────────────────────
# Used when the AutoGen factory chooses between OpenAI/Azure-OpenAI/
# Azure-Anthropic backends. One of: openai, azure, azure-anthropic.
LLM_PROVIDER=azure

# ─── Backend A: Azure OpenAI (default — what main.py auto-detects) ──────
# This is what the vision agents and data_structure agent use when
# AZURE_OPENAI_ENDPOINT is set. Models are addressed by Azure deployment name
# (NOT by OpenAI's model id) — e.g. pass --vision-model gpt-5-mini if that's
# how your deployment is named.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─── Backend B: direct OpenAI API ───────────────────────────────────────
# Used when AZURE_OPENAI_ENDPOINT is empty.
OPENAI_API_KEY=

# ─── Backend C: Azure-hosted Claude (for --vision-model claude-*) ───────
# Only needed if you want to route the vision agents to Claude via Azure.
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=

# ─── Optional: OpenRouter fallback ──────────────────────────────────────
OPENROUTER_API_KEY=

# ─── Optional: Telegram run notifications ───────────────────────────────
# Leave blank to disable. If set, main.py pings you when a run finishes.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── How to add a new model to try ──────────────────────────────────────
# Pass model IDs directly to main.py:
#   python main.py <image> \
#       --vision-model gpt-5-mini      # used by the 5 vision specialists
#       --mini-model   gpt-5-mini      # used by data_structure / verifier
#
# For Azure OpenAI, "model id" = your Azure DEPLOYMENT name.
# For direct OpenAI, "model id" = the OpenAI model name (gpt-5.4, etc.).
# For Azure Anthropic, prefix with "claude-" so main.py routes correctly.
