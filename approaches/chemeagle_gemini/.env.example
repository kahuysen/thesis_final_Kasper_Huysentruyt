# ChemEagle-Gemini pipeline — environment template.
# Copy to .env and fill in your Gemini key.
#
# _gemini.py loads these via python-dotenv at import time.

# ─── Required ──────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Optional ──────────────────────────────────────────────────────────
# Defaults to gemini-3-flash-preview if unset. Use a flash variant —
# 'gemini-2.5-pro' currently requires thinking_budget > 0 which the script
# does not pass, so it will return 400 "Budget 0 is invalid".
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible endpoint for Google's Gemini. The default is correct
# for the public API; override only if you proxy through a gateway.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ─── How to add a new model to try ─────────────────────────────────────
# Set GEMINI_MODEL to any model id Gemini exposes through its OpenAI-compat
# endpoint, e.g. gemini-2.5-flash, gemini-2.5-pro (needs thinking budget),
# gemini-3-flash-preview, etc. The pipeline does not need a code change.
