# Copy this to `.env` and fill in real values.
# .env is gitignored — never commit a populated copy.

# ───── Pick ONE of the two backends below ────────────────────────────────

# (A) Direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...
# DEFAULT_MODEL=claude-opus-4-7

# (B) Azure-hosted Claude (Azure AI Foundry serverless)
LLM_PROVIDER=azure
AZURE_ANTHROPIC_ENDPOINT=https://kaspe-mm0mkf1o-eastus2.services.ai.azure.com/anthropic/
AZURE_ANTHROPIC_API_KEY=PASTE_YOUR_AZURE_KEY_HERE
AZURE_DEPLOYMENT_NAME=claude-opus-4-7
# Optional: comma-separated list of deployments shown in the model picker.
# Use `deployment=Label` to give each one a friendly name.
# AZURE_DEPLOYMENTS=claude-opus-4-7=Opus 4.7,claude-sonnet-4-6=Sonnet 4.6,claude-haiku-4-5=Haiku 4.5

# (C) Azure OpenAI (e.g. GPT-5.4 deployment)
# LLM_PROVIDER=azure-openai
# AZURE_OPENAI_API_KEY=PASTE_YOUR_AZURE_OPENAI_KEY_HERE
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# (D-bis) OpenRouter (OpenAI-compatible gateway to 300+ models)
# OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Use model ids like: anthropic/claude-opus-4-7, openai/gpt-5.4,
# google/gemini-3-pro-preview, deepseek/deepseek-v4-flash, openrouter/auto

# (D) DeepSeek (OpenAI-compatible endpoint)
# DEEPSEEK_API_KEY=PASTE_YOUR_DEEPSEEK_KEY_HERE
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat   # or whatever V4 Flash Max is called
# Note: only multimodal DeepSeek models accept image input. The text-only
# chat / reasoner variants will reject the agent's image_url content part.

# (E) Google Gemini (direct API key)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
# GEMINI_MODEL=gemini-2.5-pro
# Optional: list of model ids in the picker (`id=Label` syntax supported).
# GEMINI_MODELS=gemini-2.5-pro=Gemini 2.5 Pro,gemini-2.5-flash=Gemini 2.5 Flash
